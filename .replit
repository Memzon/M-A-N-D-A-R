modules = ["python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Economy Bot"

[[workflows.workflow]]
name = "Discord Economy Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd econobot && python main.py"

[workflows.workflow.metadata]
outputType = "console"
