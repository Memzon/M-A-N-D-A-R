# Discord Developer Portal'dan aldığın bot tokenı
DISCORD_TOKEN=BOTUNUN_TOKENI_BURAYA

# Komutların anında görünmesi için sunucu ID'si (sağ tık sunucu -> ID kopyala)
GUILD_ID=123456789012345678

# Sandık etkinliğinin gönderileceği kanal ID'si
CHEST_CHANNEL_ID=123456789012345678

# El alıştırması (hız) etkinliğinin gönderileceği kanal ID'si
SPEED_CHANNEL_ID=123456789012345678

# Para birimi ismi ve emojisi
CURRENCY_NAME=Coin
CURRENCY_EMOJI=🪙

# Sandık etkinliği ne sıklıkla gelsin (dakika, rastgele bu aralıkta)
CHEST_MIN_INTERVAL_MIN=30
CHEST_MAX_INTERVAL_MIN=120

# El alıştırması etkinliği ne sıklıkla gelsin (dakika, rastgele bu aralıkta)
SPEED_MIN_INTERVAL_MIN=20
SPEED_MAX_INTERVAL_MIN=90

# Sandıktan çıkabilecek min/max coin
CHEST_MIN_REWARD=50
CHEST_MAX_REWARD=500

# El alıştırmasını kazanana verilecek min/max coin
SPEED_MIN_REWARD=100
SPEED_MAX_REWARD=750

# El alıştırmasında kod yazmak için verilen süre (saniye)
SPEED_TIMEOUT_SEC=30

# El alıştırması kodunun uzunluğu (harf+rakam)
SPEED_CODE_LENGTH=6
